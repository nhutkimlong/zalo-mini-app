APP_ID=your-zalo-mini-app-id
ZMP_TOKEN=your-zmp-token

# Must be public HTTPS backend URL. Do not use localhost for Zalo deploy.
VITE_BASE_URL=https://your-backend-domain.example.com

# Public Supabase anon values. Keep service_role only in backend/.env.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
