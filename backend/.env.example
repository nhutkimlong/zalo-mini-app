# FastAPI
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Supabase
# Use service_role on backend if you need admin writes/uploads.
# Never put service_role in frontend env files.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Beeknoee OpenAI-compatible API
BEEKNOEE_BASE_URL=https://platform-api.beeknoee.com/v1
BEEKNOEE_API_KEY=your-beeknoee-api-key
BEEKNOEE_LLM_MODEL=gemini-2.5-flash
BEEKNOEE_EMBED_MODEL=gemini-embedding-2
BEEKNOEE_TTS_MODEL=google/google-tts
BEEKNOEE_INPUT_COST_PER_1M=0.30
BEEKNOEE_OUTPUT_COST_PER_1M=2.50
EMBEDDING_DIM=3072

# Legacy fallback fields kept for old integrations.
OPENAI_API_KEY=
GEMINI_API_KEY=
NINEROUTER_URL=
NINEROUTER_KEY=
LLM_MODEL=gemini-2.5-flash

# Zalo OA
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
ZALO_OA_WEBHOOK_SECRET=
ZALO_OA_ACCESS_TOKEN=
